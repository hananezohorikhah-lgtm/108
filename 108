۸_ تابع ( ) average را که میانگین چهار عدد را بر می گرداند، نوشته و آزمایش کنید:
float average(float x1, float x2, float x3, float x4)

پاسخ:
#include <iostream>
using namespace std;

float average(float x1, float x2, float x3, float x4)
{
    return (x1 + x2 + x3 + x4) / 4;
}

int main()
{
    cout << average(10, 15, 20, 25);

    return 0;
}
